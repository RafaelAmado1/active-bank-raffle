{
  "framework": "nextjs",
  "regions": ["lhr1"],
  "functions": {
    "app/api/raffles/[id]/route.ts": {
      "maxDuration": 10,
      "memory": 256
    },
    "app/api/cron/cleanup/route.ts": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
