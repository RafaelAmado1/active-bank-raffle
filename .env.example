# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose client-side

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app   # no trailing slash

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Minimum 12 chars, mixed case + digits + symbols
ADMIN_PIN=your-admin-pin-min-12-chars
# generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your-secret-min-32-chars

# ─── QR / Raffle ───────────────────────────────────────────────────────────────
# HMAC-SHA256 secret for QR token signing — generate with: openssl rand -hex 32
QR_SECRET=your-secret-min-32-chars

# ─── Cron ──────────────────────────────────────────────────────────────────────
# Bearer token for the Vercel Cron job — generate with: openssl rand -hex 32
CRON_SECRET=your-secret-min-32-chars

# ─── Sentry (optional) ─────────────────────────────────────────────────────────
# Error monitoring — errors are silently swallowed without this
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=active-bank-raffle
